# CineROI AI backend environment configuration (prefix: CINEROI_)
CINEROI_ENVIRONMENT=development
CINEROI_DEBUG=true
CINEROI_DATABASE_URL=postgresql+psycopg://cineroi:cineroi@localhost:5432/cineroi
CINEROI_BROKER_URL=redis://localhost:6379/0
CINEROI_RESULT_BACKEND_URL=redis://localhost:6379/1
CINEROI_SECRET_KEY=change-me-in-production
CINEROI_SESSION_IDLE_TIMEOUT_MINUTES=30

# Encryption at rest (R28.1). Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CINEROI_ENCRYPTION_KEY=
# Set false ONLY for local/dev to allow unencrypted passthrough (never in prod).
CINEROI_ENCRYPTION_REQUIRED=true

# Data retention (R28.3). Action applied once a record's window elapses.
CINEROI_RETENTION_DEFAULT_ACTION=archive
# Per-category retention windows (days) as a JSON object; omit a key or set null
# to retain that category indefinitely.
# CINEROI_RETENTION_PERIODS_DAYS={"unreleased_script":1825,"deal_terms":2555,"pii":1095}

CINEROI_LOG_LEVEL=INFO
CINEROI_LOG_JSON=false
