# =============================================================================
# CineROI AI - PRODUCTION environment template
# =============================================================================
# Copy to `.env.prod` and fill every value. The backend REFUSES TO START in a
# production environment with any of these left at a dev default
# (see Settings.production_safety_errors). Never commit the filled-in .env.prod.
#
# Generate the two secrets with:  ./scripts/generate-secrets.sh
# =============================================================================

# --- Environment ---
CINEROI_ENVIRONMENT=production
CINEROI_DEBUG=false

# --- Secrets (REQUIRED - generate, do not reuse across environments) ---
# 32+ char random string for session/token signing.
CINEROI_SECRET_KEY=
# Distinct signing secret for service-to-service credentials (R19.5).
CINEROI_SERVICE_CREDENTIAL_SECRET=
# Fernet key for encryption at rest (R28.1):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CINEROI_ENCRYPTION_KEY=
CINEROI_ENCRYPTION_REQUIRED=true

# --- Database (managed PostgreSQL 16 + pgvector; NOT the bundled dev db) ---
# Use real credentials and a managed host. Async psycopg driver.
CINEROI_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@db-host:5432/cineroi

# --- Task queue (managed Redis) ---
CINEROI_BROKER_URL=redis://redis-host:6379/0
CINEROI_RESULT_BACKEND_URL=redis://redis-host:6379/1

# --- Host / CORS hardening ---
# Pin the real public hostname(s); never leave as "*" in production.
CINEROI_TRUSTED_HOSTS=["app.example.com"]
# Browser origin(s) allowed to call the API.
CINEROI_CORS_ALLOW_ORIGINS=["https://app.example.com"]

# --- SSO (R19.1) ---
# Expected audience/issuer the IdP stamps on OIDC/SAML assertions.
CINEROI_SSO_AUDIENCE=https://app.example.com

# --- Embedding provider (R2.1 Narrative_DNA) ---
# "deterministic" is dev/demo only. Production uses a real model:
CINEROI_EMBEDDING_PROVIDER=openai
CINEROI_EMBEDDING_API_KEY=
CINEROI_EMBEDDING_MODEL=text-embedding-3-small
# CINEROI_EMBEDDING_BASE_URL=

# --- Data retention (R28.3) ---
CINEROI_RETENTION_DEFAULT_ACTION=archive

# --- Logging ---
CINEROI_LOG_LEVEL=INFO
CINEROI_LOG_JSON=true

# --- Frontend (public API base URL baked at build time) ---
NEXT_PUBLIC_API_BASE_URL=https://app.example.com